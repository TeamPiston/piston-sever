# 생성기 선택: hardcoded (기본) | gpt
SCAD_GENERATOR=hardcoded

# OpenAI (SCAD_GENERATOR=gpt 일 때만 필요)
OPENAI_API_KEY=

# Moonraker 주소 (예: http://192.168.1.100:7125)
MOONRAKER_URL=http://192.168.x.x:7125

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# 파일 저장 경로
OUTPUT_DIR=./output

# OpenSCAD 바이너리 경로
# 로컬 맥: /Applications/OpenSCAD.app/Contents/MacOS/OpenSCAD
# Docker/Linux: /usr/bin/openscad
OPENSCAD_BIN=/usr/bin/openscad

# CuraEngine 바이너리 경로
CURA_BIN=/usr/bin/CuraEngine

# CuraEngine 기본 정의 파일 디렉토리
CURA_DEFINITIONS_PATH=/usr/share/cura-engine/resources/definitions

# Qidi Max 4 프로필 경로 (기본값 사용 시 생략 가능)
CURA_PROFILE_PATH=./src/slicer/profiles/qidi_max4.def.json
